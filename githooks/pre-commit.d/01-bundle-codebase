#!/usr/bin/env bash

set -euo pipefail

# Force safe system fallback locales
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

REPO_ROOT="$(git rev-parse --show-toplevel)"
BUNDLE_SCRIPT="${REPO_ROOT}/scripts/workstation/bundle-codebase.sh"

if [ -f "$BUNDLE_SCRIPT" ]; then
    chmod +x "$BUNDLE_SCRIPT"
    "$BUNDLE_SCRIPT"
else
    echo "⚠️  Compiler script not found at $BUNDLE_SCRIPT. Skipping compilation."
fi
