#!/usr/bin/env bash
set -euo pipefail

# Find the repository root dynamically (matching our directory anchoring standard)
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE [0]}")" && pwd)"
REPO_ROOT="$(cd "${HOOK_DIR}/../.." && pwd)"

echo "⚓ Running sub-hook: 03-audit-secrets"
"${REPO_ROOT}/scripts/workstation/audit-repo-secrets.sh"
